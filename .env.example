# Where the app sends every request. It has to name YOUR machine, because the backend
# under test is the one you start yourself with `php artisan serve --host=0.0.0.0 --port=8000`.
#
# Use your machine's address on the local network -- `ipconfig` on Windows, `ip addr`
# elsewhere -- not `localhost`, which from the app's point of view means the phone. The
# emulator-only nickname `http://10.0.2.2:8000/api/v1` also works, but ONLY inside an
# emulator: a real handset has no such address.
#
# This value must match `app.json` -> testing.channels.mobile.live.apiUrl, and a live run
# refuses to start when they disagree. Full explanation, including what to do when your
# network hands you a new address: docs/testing/which-backend-the-app-is-tested-against.md
EXPO_PUBLIC_API_URL=http://192.168.68.232:8000/api/v1

# Google Maps Android API key. Required — react-native-maps on Android is Google Maps,
# and a build without this key crashes the process the moment a map mounts.
# Provision one in the Google Cloud console (Maps SDK for Android must be enabled) and
# restrict it to package com.zivsluck.stourify + the signing SHA-1.
# Full steps: docs/google-maps-api-key.md
GOOGLE_MAPS_API_KEY=

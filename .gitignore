# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
# Any keystore. The release key lives outside the repo entirely (STOURIFY-300);
# this is the backstop. debug.keystore is public and already tracked.
*.keystore
!android/app/debug.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Environment variables
.env
.env.local
# The APK builder copies .env aside before it rewrites it. That copy holds the same
# secrets as .env itself, so it must be as unstageable as the original.
.env.bak-*

# local env files
.env*.local

# typescript
*.tsbuildinfo
android/.kotlin/errors

# Throwaway test artifacts (screenshots, recordings, traces). The root CLAUDE.md
# sends them here, so this folder must never be stageable.
.screenshots/

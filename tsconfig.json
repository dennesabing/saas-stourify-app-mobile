{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@soxerp/offline-sync-core": [
        "src/types/offline-sync-core.d.ts"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": ["src", "__tests__", "App.tsx", "*.d.ts"],
  "exclude": ["node_modules", "../packages/**"]
}